# Copy to .env and set the values. Astro passes .env into the containers.
# After a change: astro dev restart
#
# Put a value in single quotes if it contains & ? $ spaces or # (for example a
# DSN with ?sslmode=require&channel_binding=require). Without quotes, a shell
# that reads this file (set -a; . ./.env) cuts the value at the &.

# --- database --------------------------------------------------------------
# From the Airflow containers on the VPS (Postgres on the host):
SPP_DSN=postgresql://spp:CHANGE_ME@host.docker.internal:5432/spp
# Throwaway database for DB-backed tests only:
# SPP_TEST_DSN='postgresql://spp:CHANGE_ME@localhost:5432/spp_test'

# --- logging ---------------------------------------------------------------
SPP_LOG_LEVEL=INFO
SPP_LOG_FORMAT=json

# --- SPP feeds -------------------------------------------------------------
# SPP_PORTAL=https://portal.spp.org/file-browser-api/download
SPP_HTTP_TIMEOUT=30
SPP_HTTP_RETRIES=3
SPP_START_OFFSET_SECONDS=15
SPP_TASK_RETRIES=3
# Node / zone groups (config/groups.json). An Airflow Variable of the same
# name in lower case (spp_rt_lmp_groups) has priority over these.
# SPP_RT_LMP_GROUPS=nppd,kmea
# SPP_DA_LMP_GROUPS=nppd,kmea
# SPP_RT_MCP_GROUPS=default
# SPP_DA_MCP_GROUPS=default

# --- SCADA: Beatrice (Airflow on the VPS) ----------------------------------
BEATRICE_USER=
BEATRICE_PWD=
BEATRICE_LOGIN_URL=
BEATRICE_SVG_URL=
# BEATRICE_MW_CEIL=
# Chromium and chromedriver from packages.txt (Airflow image only):
SCADA_CHROME_BINARY=/usr/bin/chromium
SCADA_CHROMEDRIVER=/usr/bin/chromedriver

# --- SCADA: Garden City (VPN device only, not the VPS) ---------------------
# Reads GC_JAMESON, GC_LEWIS and GC_TOTAL from the load SVG page.
# GC_SVG_LINK=
# GC_MW_CEIL=10            # ceiling for each meter (Jameson, Lewis)
# GC_TOTAL_MW_CEIL=20      # ceiling for the total
# GC_TOTAL_TOLERANCE=0.1   # MW; warn when total != Jameson + Lewis
# GC_PAGE_WAIT=30          # seconds to wait for all three values to show a number
# SCADA_LOG_FILE=logs/gc_scraper.log

# --- SCADA: Sherburne city load (standalone sherburne_city.py) -------------
# One login, then SC_READS readings of "Demand now", one every SC_READ_INTERVAL s.
# SC_LOGIN_LINK=
# SC_USER=
# SC_PWD=
# SC_READS=15
# SC_READ_INTERVAL=60
# SC_PAGE_WAIT=30
# SC_VALUE_UNIT=MW         # MW or kW, used when the page shows no unit
# SC_MW_CEIL=100
